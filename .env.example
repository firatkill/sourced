# Sourced settings. Copy this file and fill in one line:
#
#   cp .env.example .env.local
#
# Keep .env.local to yourself: it holds your API key and is never committed.

# Your OpenAI API key (https://platform.openai.com/api-keys). The default
# configuration uses OpenAI for answers and for embeddings.
OPENAI_API_KEY=

# Using another provider? Put its key here instead and choose it in sourced.config.ts.
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# Ollama runs models on your own machine and needs no key. Docker reaches it at:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Change these if port 3000 (the app) or 5433 (the database) is already taken.
# SOURCED_PORT=3000
# SOURCED_DB_PORT=5433

# ---------------------------------------------------------------------------
# Everything below is optional. The defaults suit a local install, and the
# Docker path sets the database connection itself. Uncomment a line to change it.
# ---------------------------------------------------------------------------

# Node path only (pnpm sourced ...): the local database started by `pnpm db:up`.
# DATABASE_URL=postgres://sourced:sourced@localhost:5433/sourced
# MIGRATION_DATABASE_URL=postgres://sourced:sourced@localhost:5433/sourced
# TEST_DATABASE_URL=postgres://sourced:sourced@localhost:5433/sourced_test
# DATABASE_POOL_MAX=5

# `mock` answers without calling any provider (for trying the app offline).
# LLM_MODE=live
# LLM_PROVIDER=openai
# MAX_OUTPUT_TOKENS=700
# Ask before ingesting above this estimated embedding cost (USD).
# INGEST_CONFIRM_ABOVE_USD=1.00
# Stop an evaluation run above this estimated cost (USD).
# EVAL_MAX_COST_USD=1.00
# EVAL_RESULTS_DIR=eval/postgres-17/results
# INGEST_INCLUDE_FIXTURES=false
# STORE_QUESTIONS=false
# LOG_LEVEL=info
# MOCK_STREAM_DELAY_MS=10
# Local default: http://localhost:<SOURCED_PORT>.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ALLOWED_ORIGINS=

# Evaluation judge: pinned on 2026-11-09 (D-82); used only by `sourced eval`.
# JUDGE_MODEL=gpt-5.4
# USD per 1M tokens for the judge, list price checked 2026-11-09.
# PRICE_JUDGE_INPUT_PER_MTOK=2.50
# PRICE_JUDGE_OUTPUT_PER_MTOK=15.00

# Hosted profiles only. `private` needs an access token of at least 24 characters;
# `public-demo` needs the salts (openssl rand -hex 32), quotas and prices below.
# SOURCED_PROFILE=public-demo
# SOURCED_ACCESS_TOKEN=
# IP_HASH_SALT=dev-only-ip-salt-change-me-000000000000000
# QUESTION_HASH_SALT=dev-only-question-salt-change-me-00000000
# DEMO_MODE=on
# RATE_LIMIT_IP_DAILY=10
# RATE_LIMIT_GLOBAL_DAILY=300
# Pinned on 2026-11-09 from https://developers.openai.com/api/docs/models/gpt-6-luna
# CHAT_MODEL=gpt-6-luna
# Standard USD per 1M tokens, checked 2026-11-09 (https://developers.openai.com/api/docs/pricing).
# PRICE_CHAT_INPUT_PER_MTOK=0.10
# PRICE_CHAT_OUTPUT_PER_MTOK=0.50
# PRICE_EMBED_PER_MTOK=0.02

# Platform-provided; do not set for local development.
# VERCEL_ENV=
# VERCEL_URL=
# VERCEL_BRANCH_URL=
# VERCEL_PROJECT_PRODUCTION_URL=
# VERCEL_GIT_COMMIT_SHA=
# VERCEL=
# NODE_ENV=
# GITHUB_STEP_SUMMARY=
