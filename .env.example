# Local Docker connections; never commit production credentials.
DATABASE_URL=postgres://sourced:sourced@localhost:5433/sourced
MIGRATION_DATABASE_URL=postgres://sourced:sourced@localhost:5433/sourced
TEST_DATABASE_URL=postgres://sourced:sourced@localhost:5433/sourced_test
DATABASE_POOL_MAX=5
LLM_MODE=live
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Empty uses http://localhost:11434; Docker: http://host.docker.internal:11434
OLLAMA_BASE_URL=
# Pinned on 2026-11-09 from https://developers.openai.com/api/docs/models/gpt-6-luna
CHAT_MODEL=gpt-6-luna
# Pinned on 2026-11-09 from https://developers.openai.com/api/docs/models/gpt-5.4 (D-82).
# Eval only; runs in the sourced-eval project with data sharing on. No dated snapshot is offered.
JUDGE_MODEL=gpt-5.4
MAX_OUTPUT_TOKENS=700
# Standard USD per 1M tokens, checked 2026-11-09.
# https://developers.openai.com/api/docs/pricing
# gpt-6-luna: $0.10 / 1M input tokens.
PRICE_CHAT_INPUT_PER_MTOK=0.10
# gpt-6-luna: $0.50 / 1M output tokens.
PRICE_CHAT_OUTPUT_PER_MTOK=0.50
# text-embedding-3-small: $0.02 / 1M tokens, checked 2026-11-09.
# https://developers.openai.com/api/docs/models/text-embedding-3-small
PRICE_EMBED_PER_MTOK=0.02
# gpt-5.4: $2.50 / 1M input tokens, list price checked 2026-11-09 (budget guard uses list price).
PRICE_JUDGE_INPUT_PER_MTOK=2.50
# gpt-5.4: $15.00 / 1M output tokens, list price checked 2026-11-09.
PRICE_JUDGE_OUTPUT_PER_MTOK=15.00
# Required only for the private profile: at least 24 characters.
SOURCED_ACCESS_TOKEN=
DEMO_MODE=on
RATE_LIMIT_IP_DAILY=10
RATE_LIMIT_GLOBAL_DAILY=300
# Development only. Production: separate values from openssl rand -hex 32.
IP_HASH_SALT=dev-only-ip-salt-change-me-000000000000000
QUESTION_HASH_SALT=dev-only-question-salt-change-me-00000000
STORE_QUESTIONS=false
LOG_LEVEL=info
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=
INGEST_INCLUDE_FIXTURES=false
EVAL_MAX_COST_USD=1.00
EVAL_RESULTS_DIR=eval/postgres-17/results
MOCK_STREAM_DELAY_MS=10
# Platform-provided; do not set for local development.
# VERCEL_ENV=
# VERCEL_URL=
# VERCEL_BRANCH_URL=
# VERCEL_PROJECT_PRODUCTION_URL=
# VERCEL_GIT_COMMIT_SHA=
# VERCEL=
# NODE_ENV=
# GITHUB_STEP_SUMMARY=
