#!/bin/sh
set -eu
BUILDX_NO_DEFAULT_ATTESTATIONS=${BUILDX_NO_DEFAULT_ATTESTATIONS-1}
export BUILDX_NO_DEFAULT_ATTESTATIONS
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
command=${1:-help}
if [ ! -f .env.local ]; then
  case "$command" in
    # T-88: dev and setup start without one; the browser asks for the key.
    init|doctor|dev|setup) ;;
    *) printf '%s\n' 'Run ./sourced dev first, then finish setup in your browser.' >&2; exit 2 ;;
  esac
fi
if ! command -v docker >/dev/null 2>&1; then
  case "$(uname -s)" in
    Darwin) link=https://docs.docker.com/desktop/setup/install/mac-install/ ;;
    *) link=https://docs.docker.com/engine/install/ ;;
  esac
  printf 'Install Docker: %s\n' "$link" >&2
  exit 2
fi
[ -f .env.local ] || (umask 077; touch .env.local)
# D-136: one Compose project per checkout, so two clones never share a database.
# Compose reads COMPOSE_PROJECT_NAME from .env in this folder, so the launchers,
# the Node CLI and a plain `docker compose` all use the same project.
if [ -z "${COMPOSE_PROJECT_NAME:-}" ]; then
  project=
  if [ -f .env ]; then
    project=$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' .env | tail -n 1 | tr -d '\r')
  fi
  if [ -z "$project" ]; then
    # Upgrades keep the project (and data) their containers already use.
    if listing=$(docker ps -a --format '{{.Label "com.docker.compose.project.working_dir"}}|{{.Label "com.docker.compose.project"}}' 2>/dev/null); then
      here=$(pwd -P | tr '[:upper:]' '[:lower:]')
      project=$(printf '%s\n' "$listing" | while IFS='|' read -r dir name; do
        if [ -n "$name" ] && [ "$(printf '%s' "$dir" | tr '[:upper:]' '[:lower:]')" = "$here" ]; then
          printf '%s\n' "$name"
          break
        fi
      done)
      [ -n "$project" ] || project="sourced-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
      if [ -s .env ] && [ -n "$(tail -c 1 .env)" ]; then printf '\n' >> .env; fi
      printf 'COMPOSE_PROJECT_NAME=%s\n' "$project" >> .env
    fi
  fi
  if [ -n "$project" ]; then
    COMPOSE_PROJECT_NAME=$project
    export COMPOSE_PROJECT_NAME
  fi
fi
# Parse only literal port assignments; never source or evaluate the env file.
carriage_return=$(printf '\r')
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%"$carriage_return"}
  case "$line" in
    SOURCED_PORT=*)
      if [ "${SOURCED_PORT+x}" != x ]; then
        SOURCED_PORT=${line#SOURCED_PORT=}
        export SOURCED_PORT
      fi ;;
    SOURCED_DB_PORT=*)
      if [ "${SOURCED_DB_PORT+x}" != x ]; then
        SOURCED_DB_PORT=${line#SOURCED_DB_PORT=}
        export SOURCED_DB_PORT
      fi ;;
    SOURCED_DOCLING_PORT=*)
      if [ "${SOURCED_DOCLING_PORT+x}" != x ]; then
        SOURCED_DOCLING_PORT=${line#SOURCED_DOCLING_PORT=}
        export SOURCED_DOCLING_PORT
      fi ;;
  esac
done < .env.local
SOURCED_UID=$(id -u)
export SOURCED_UID
json=false
for argument in "$@"; do
  [ "$argument" != --json ] || json=true
done
# Only fixed command names enter launcher-generated JSON.
case "$command" in
  *[!a-z:-]*|'') envelope_command=unknown ;;
  *) envelope_command=$command ;;
esac
compose_step() {
  step=$1
  shift
  if [ "$json" = false ]; then docker "$@"; return $?; fi
  # Stream CLI JSON lines; send the process status through the pipe without files.
  {
    status=0
    docker "$@" 2>&1 || status=$?
    printf '\n__SOURCED_COMPOSE_EXIT__%s\n' "$status"
  } | (
    emitted=false
    fix='Check Docker is running, then retry'
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      case "$line" in
        __SOURCED_COMPOSE_EXIT__*)
          status=${line#__SOURCED_COMPOSE_EXIT__}
          if [ "$emitted" = true ]; then exit "$status"; fi
          if [ "$status" -ne 0 ]; then
            printf '{"schemaVersion":1,"command":"%s","ok":false,"error":{"code":"INTERNAL_ERROR","message":"%s failed.","fix":"%s"},"warnings":[]}\n' "$envelope_command" "$step" "$fix"
            exit 1
          fi
          exit 0 ;;
        *'port is already allocated'*|*'address already in use'*|*'ports are not available'*|*'Ports are not available'*)
          fix='Set SOURCED_DB_PORT (or SOURCED_PORT) to a free port in .env.local, then retry.' ;;
      esac
      if [ "$step" = 'CLI container start' ]; then
        case "$line" in
          '{"schemaVersion":1,'*)
            if [ "$emitted" = false ]; then printf '%s\n' "$line"; emitted=true; fi ;;
          *) printf '%s\n' "$line" >&2 ;;
        esac
      else
        # Build and Compose progress stays visible on stderr.
        printf '%s\n' "$line" >&2
      fi
    done
  )
}
setup_token() {
  # T-88: the same 48-hex-digit token lib/setup/token.ts reads; never in .env.local.
  mkdir -p .sourced
  token=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
  (umask 077; printf '%s\n' "$token" > .sourced/setup-token.tmp)
  mv .sourced/setup-token.tmp .sourced/setup-token
  printf '%s' "$token"
}
case "$command" in
  setup)
    shift
    port=${SOURCED_PORT:-3000}
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --json) ;;
        --port) shift; port=${1:-} ;;
        *) printf '%s\n' 'Usage: ./sourced setup [--port <port>] [--json]' >&2; exit 2 ;;
      esac
      [ "$#" -eq 0 ] || shift
    done
    case "$port" in
      ''|*[!0-9]*) printf '%s\n' 'Port must be an integer from 1 to 65535.' >&2; exit 2 ;;
    esac
    url="http://localhost:$port/setup?token=$(setup_token)"
    if [ "$json" = true ]; then
      printf '{"schemaVersion":1,"command":"setup","ok":true,"result":{"url":"%s"},"warnings":[]}\n' "$url"
    else
      printf 'Open this link to finish setup in your browser:\n%s\nIt replaces any earlier link.\n' "$url"
    fi
    exit 0
    ;;
  down)
    json=false
    for argument in "$@"; do
      [ "$argument" != --json ] || json=true
    done
    if [ "$json" = false ]; then
      exec docker compose --profile docling down
    fi
    # Down stops the containers, so emit the fixed envelope without starting one.
    if docker compose --profile docling down >&2; then
      printf '%s\n' '{"schemaVersion":1,"command":"down","ok":true,"result":{},"warnings":[]}'
      exit 0
    else
      printf '%s\n' '{"schemaVersion":1,"command":"down","ok":false,"error":{"code":"INTERNAL_ERROR","message":"Docker Compose down failed.","fix":"Check Docker is running, then retry ./sourced down --json."},"warnings":[]}'
      exit 1
    fi
    ;;
  dev)
    shift
    json=false
    SOURCED_PORT=${SOURCED_PORT:-3000}
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --json) json=true ;;
        --port) shift; SOURCED_PORT=${1:-} ;;
        *) printf '%s\n' 'Usage: ./sourced dev [--port <port>] [--json]' >&2; exit 2 ;;
      esac
      [ "$#" -eq 0 ] || shift
    done
    case "$SOURCED_PORT" in
      ''|*[!0-9]*) printf '%s\n' 'Port must be an integer from 1 to 65535.' >&2; exit 2 ;;
    esac
    if [ "$SOURCED_PORT" -lt 1 ] || [ "$SOURCED_PORT" -gt 65535 ]; then
      printf '%s\n' 'Port must be an integer from 1 to 65535.' >&2
      exit 2
    fi
    export SOURCED_PORT
    # The app writes its startup failure here (D-137); clear any earlier one first.
    rm -f .sourced/startup-error.json .sourced/startup-error.txt
    if [ "$json" = true ]; then
      compose_step 'App container start' compose up -d --build --force-recreate app || exit $?
    else
      docker compose up -d --build --force-recreate app >&2 || exit 1
    fi
    # D-152: a library read with Docling gets its reader back after ./sourced down.
    if grep -q '"engine": "docling"' .sourced/config.json 2>/dev/null; then
      if [ "$json" = true ]; then
        compose_step 'Docling start' compose --profile docling up -d docling || exit $?
      else
        docker compose --profile docling up -d docling >&2 || exit 1
      fi
    fi
    attempts=${SOURCED_DEV_ATTEMPTS:-60}
    attempt=0
    started=false
    while [ "$attempt" -lt "$attempts" ]; do
      attempt=$((attempt + 1))
      [ ! -f .sourced/startup-error.json ] || break
      if [ -z "$(docker compose ps -q --status running app 2>/dev/null)" ]; then
        # The container stopped: stop waiting at once instead of polling for a minute.
        [ -z "$(docker compose ps -a -q --status exited app 2>/dev/null)" ] || break
      elif docker compose exec -T app node --input-type=module -e '
        const response = await fetch("http://127.0.0.1:3000/api/health", { signal: AbortSignal.timeout(1000) }).catch(() => null);
        process.exit(response?.ok ? 0 : 1);
        ' >/dev/null 2>&1; then
        started=true
        break
      fi
      sleep "${SOURCED_DEV_INTERVAL:-1}"
    done
    if [ "$started" = false ]; then
      if [ -f .sourced/startup-error.json ]; then
        if [ "$json" = true ]; then
          cat .sourced/startup-error.json
        else
          cat .sourced/startup-error.txt >&2
        fi
      elif [ "$json" = true ]; then
        printf '%s\n' '{"schemaVersion":1,"command":"dev","ok":false,"error":{"code":"INTERNAL_ERROR","message":"The app did not start.","fix":"Run docker compose logs app to see why, then retry ./sourced dev --json."},"warnings":[]}'
      else
        printf '%s\n' 'The app did not start. Its last log lines:' >&2
        docker compose logs --no-color --tail 5 app >&2 || true
        printf '%s\n' 'Next: docker compose logs app' >&2
      fi
      exit 1
    fi
    # The app writes setup-pending while no provider key is saved (T-88).
    setup_url=
    if [ -f .sourced/setup-pending ] && token=$(cat .sourced/setup-token 2>/dev/null) && [ -n "$token" ]; then
      setup_url="http://localhost:$SOURCED_PORT/setup?token=$token"
    fi
    if [ "$json" = true ]; then
      if [ -n "$setup_url" ]; then
        printf '{"schemaVersion":1,"command":"dev","ok":true,"result":{"url":"http://localhost:%s","setupUrl":"%s"},"warnings":[]}\n' "$SOURCED_PORT" "$setup_url"
      else
        printf '{"schemaVersion":1,"command":"dev","ok":true,"result":{"url":"http://localhost:%s"},"warnings":[]}\n' "$SOURCED_PORT"
      fi
    elif [ -n "$setup_url" ]; then
      printf 'Sourced is running. Finish setup in your browser:\n%s\nStop it with ./sourced down\n' "$setup_url"
    else
      printf 'Sourced is running at http://localhost:%s\nStop it with ./sourced down\n' "$SOURCED_PORT"
    fi
    exit 0
    ;;
  init) printf '%s\n' 'Building the image on first run takes a few minutes.' >&2 ;;
  docling)
    # D-152: the CLI container has no Docker socket, so the launcher starts or stops Docling.
    case "${2:-}" in
      on)
        [ "$json" = true ] || printf '%s\n' 'Downloading Docling the first time (about 2.1 GB, 6.5 GB on disk), then starting it.' >&2
        compose_step 'Docling download and start' compose --profile docling up -d docling || exit $? ;;
      off) compose_step 'Docling stop' compose --profile docling stop docling || exit $? ;;
      status) ;;
      *) printf '%s\n' 'Usage: ./sourced docling on|off|status [--json]' >&2; exit 2 ;;
    esac ;;
esac
compose_step 'CLI image build' compose build cli || exit $?
compose_step 'Database container start' compose up -d --wait db || exit $?
# Prepend each argument without eval so spaces and shell metacharacters stay literal.
set -- cli "$@"
if [ -f .sourced/mounts ]; then
  while IFS= read -r mount || [ -n "$mount" ]; do
    [ -n "$mount" ] || continue
    set -- -v "$mount:$mount:ro" "$@"
  done < .sourced/mounts
fi
if [ -t 0 ]; then
  compose_step 'CLI container start' compose run --no-deps --rm "$@"
else
  compose_step 'CLI container start' compose run --no-deps --rm -T "$@"
fi
